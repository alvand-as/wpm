# Meta App > WhatsApp > API Setup
WHATSAPP_TOKEN=your_temporary_or_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Recipient for scripts/send.sh — must be a test number you added in the
# Meta dashboard until the WhatsApp Business Account is verified.
WHATSAPP_TO=15551234567

# Any string you make up — must match what you enter in the Meta
# dashboard's webhook "Verify Token" field.
WHATSAPP_VERIFY_TOKEN=choose_a_shared_secret
